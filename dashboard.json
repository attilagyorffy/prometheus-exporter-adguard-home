{
  "dashboard": {
    "uid": "adguard-home-exporter",
    "title": "AdGuard Home",
    "description": "DNS filtering metrics from AdGuard Home, scraped by the custom prometheus-exporter-adguard-home exporter. Shows query statistics, top domains/clients, upstream performance, and filtering configuration.",
    "tags": ["adguard", "dns", "networking"],
    "timezone": "browser",
    "refresh": "1m",
    "time": { "from": "now-3h", "to": "now" },
    "schemaVersion": 39,
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 1,
    "links": [],
    "templating": {
      "list": [
        {
          "name": "datasource",
          "type": "datasource",
          "query": "prometheus",
          "current": {},
          "hide": 0
        },
        {
          "name": "client",
          "type": "query",
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "definition": "label_values(adguard_top_clients{job=\"adguard\"}, name)",
          "query": "label_values(adguard_top_clients{job=\"adguard\"}, name)",
          "includeAll": true,
          "allValue": ".*",
          "multi": true,
          "current": { "selected": true, "text": "All", "value": "$__all" },
          "sort": 1,
          "refresh": 2,
          "hide": 0
        }
      ]
    },
    "panels": [
      {
        "id": 100,
        "type": "row",
        "title": "Overview",
        "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
        "collapsed": false
      },
      {
        "id": 1,
        "type": "stat",
        "title": "Status",
        "description": "Whether the exporter can reach AdGuard Home (`adguard_up`). **Down (red)** means DNS resolution for the whole network is likely broken — clients fall back to their secondary DNS or fail. Check the AdGuard container is running and the exporter's API URL/credentials are correct, then confirm the box answers on port 53. Stays red until the scrape succeeds again.",
        "gridPos": { "x": 0, "y": 1, "w": 4, "h": 3 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "targets": [
          {
            "refId": "A",
            "expr": "adguard_up{job=\"adguard\"}",
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "mappings": [
              {
                "type": "value",
                "options": {
                  "0": { "text": "Down", "color": "red", "index": 0 },
                  "1": { "text": "Up", "color": "green", "index": 1 }
                }
              }
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": null, "color": "red" },
                { "value": 1, "color": "green" }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "colorMode": "background",
          "textMode": "value"
        }
      },
      {
        "id": 2,
        "type": "stat",
        "title": "Protection",
        "description": "Master protection switch in AdGuard Home (`adguard_protection_enabled`). **Disabled (red)** means nothing is being filtered — all ads/trackers/malware domains resolve normally. If unexpected, re-enable it in the AdGuard UI (Settings → General → Protection) or check whether someone hit the 30-min pause. Normal state is green.",
        "gridPos": { "x": 4, "y": 1, "w": 4, "h": 3 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "targets": [
          {
            "refId": "A",
            "expr": "adguard_protection_enabled{job=\"adguard\"}",
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "mappings": [
              {
                "type": "value",
                "options": {
                  "0": { "text": "Disabled", "color": "red", "index": 0 },
                  "1": { "text": "Enabled", "color": "green", "index": 1 }
                }
              }
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "value": null, "color": "red" },
                { "value": 1, "color": "green" }
              ]
            }
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "colorMode": "background",
          "textMode": "value"
        }
      },
      {
        "id": 3,
        "type": "stat",
        "title": "Version",
        "description": "AdGuard Home version currently running (`adguard_build_info`). Informational — no action needed. If it lags well behind upstream, update via the AdGuard UI (Settings → check for updates) or your container image tag to pick up filtering and security fixes.",
        "gridPos": { "x": 8, "y": 1, "w": 4, "h": 3 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "targets": [
          {
            "refId": "A",
            "expr": "adguard_build_info{job=\"adguard\"}",
            "legendFormat": "{{version}}",
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": { "mode": "fixed", "fixedColor": "blue" },
            "thresholds": {
              "mode": "absolute",
              "steps": [{ "value": null, "color": "blue" }]
            }
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "colorMode": "background",
          "textMode": "name"
        }
      },
      {
        "id": 4,
        "type": "stat",
        "title": "Avg Processing Time",
        "description": "Mean time AdGuard takes to answer a query over the 24h window. Healthy is single-digit milliseconds (cache hits) up to tens of ms (upstream lookups). If it climbs into hundreds of ms, browsing feels slow: check the **Upstream Response Time** panel for a slow/failing resolver and confirm DNS caching is On. [DNS filtering syntax & settings](https://adguard-dns.io/kb/general/dns-filtering-syntax/)",
        "gridPos": { "x": 12, "y": 1, "w": 4, "h": 3 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "targets": [
          {
            "refId": "A",
            "expr": "adguard_avg_processing_seconds{job=\"adguard\"}",
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "color": { "mode": "fixed", "fixedColor": "purple" },
            "thresholds": {
              "mode": "absolute",
              "steps": [{ "value": null, "color": "purple" }]
            }
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "colorMode": "background",
          "textMode": "value"
        }
      },
      {
        "id": 5,
        "type": "stat",
        "title": "DNS Queries (24h)",
        "description": "Total queries handled in the rolling 24h window. Informational baseline for normal network chatter. A sudden order-of-magnitude jump can mean a misbehaving device in a DNS loop or malware beaconing — cross-check **Top Clients** to find the source, then inspect that device. A drop to near-zero means clients stopped using this resolver (check **Status**).",
        "gridPos": { "x": 16, "y": 1, "w": 4, "h": 3 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "targets": [
          {
            "refId": "A",
            "expr": "adguard_dns_queries{job=\"adguard\"}",
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": { "mode": "fixed", "fixedColor": "blue" },
            "thresholds": {
              "mode": "absolute",
              "steps": [{ "value": null, "color": "blue" }]
            }
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "colorMode": "background",
          "textMode": "value"
        }
      },
      {
        "id": 6,
        "type": "stat",
        "title": "% Blocked",
        "description": "Share of queries blocked by filtering, safe browsing, safe search or parental controls. Typically 5–25% on a normal network. **Near 0%** suggests filtering isn't working — verify **Protection**/**Filtering** are On and that **Filter Lists** loaded rules. **Unusually high** can mean an overly aggressive blocklist breaking sites — review **Top Blocked Domains** and whitelist false positives. [DNS filtering syntax](https://adguard-dns.io/kb/general/dns-filtering-syntax/)",
        "gridPos": { "x": 20, "y": 1, "w": 4, "h": 3 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "targets": [
          {
            "refId": "A",
            "expr": "(adguard_blocked_filtering{job=\"adguard\"} + adguard_replaced_safebrowsing{job=\"adguard\"} + adguard_replaced_safesearch{job=\"adguard\"} + adguard_replaced_parental{job=\"adguard\"}) / adguard_dns_queries{job=\"adguard\"}",
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "decimals": 1,
            "color": { "mode": "fixed", "fixedColor": "orange" },
            "thresholds": {
              "mode": "absolute",
              "steps": [{ "value": null, "color": "orange" }]
            }
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "colorMode": "background",
          "textMode": "value"
        }
      },
      {
        "id": 200,
        "type": "row",
        "title": "Queries",
        "gridPos": { "x": 0, "y": 4, "w": 24, "h": 1 },
        "collapsed": false
      },
      {
        "id": 7,
        "type": "timeseries",
        "title": "DNS Queries",
        "description": "Total queries (24h rolling counter) plotted over time, showing the daily rhythm of DNS activity. Use it to spot anomalies: a flat line means queries stopped flowing (clients not using this resolver — check **Status**), a sharp sustained spike means a device is hammering DNS — identify it in **Top Clients** / **Client Queries**.",
        "gridPos": { "x": 0, "y": 5, "w": 8, "h": 8 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "targets": [
          {
            "refId": "A",
            "expr": "adguard_dns_queries{job=\"adguard\"}",
            "legendFormat": "Total Queries"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": { "mode": "palette-classic" },
            "custom": {
              "drawStyle": "line",
              "lineWidth": 1,
              "fillOpacity": 10,
              "pointSize": 5,
              "showPoints": "never",
              "spanNulls": true
            }
          },
          "overrides": []
        },
        "options": {
          "tooltip": { "mode": "multi", "sort": "desc" },
          "legend": { "displayMode": "list", "placement": "bottom" }
        }
      },
      {
        "id": 23,
        "type": "timeseries",
        "title": "Blocked & Replaced",
        "description": "Blocked/replaced queries split by reason (filtering, safe browsing, safe search, parental) over the 24h window. Filtering is normally the dominant line. If all lines flatten near zero while query volume is high, filtering has effectively stopped — check **Filter Lists** updated successfully and **Protection** is On. A sudden jump in one category points at a new or noisy blocklist; correlate with **Top Blocked Domains**.",
        "gridPos": { "x": 8, "y": 5, "w": 8, "h": 8 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "targets": [
          {
            "refId": "A",
            "expr": "adguard_blocked_filtering{job=\"adguard\"}",
            "legendFormat": "Blocked"
          },
          {
            "refId": "B",
            "expr": "adguard_replaced_safebrowsing{job=\"adguard\"}",
            "legendFormat": "Safe Browsing"
          },
          {
            "refId": "C",
            "expr": "adguard_replaced_safesearch{job=\"adguard\"}",
            "legendFormat": "Safe Search"
          },
          {
            "refId": "D",
            "expr": "adguard_replaced_parental{job=\"adguard\"}",
            "legendFormat": "Parental"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": { "mode": "palette-classic" },
            "custom": {
              "drawStyle": "line",
              "lineWidth": 1,
              "fillOpacity": 10,
              "pointSize": 5,
              "showPoints": "never",
              "spanNulls": true
            }
          },
          "overrides": []
        },
        "options": {
          "tooltip": { "mode": "multi", "sort": "desc" },
          "legend": { "displayMode": "list", "placement": "bottom" }
        }
      },
      {
        "id": 8,
        "type": "piechart",
        "title": "Block Reasons",
        "description": "Proportion of blocks by category right now. Mostly informational — confirms which protection layer is doing the work (usually filter lists). If a category you expect to be active shows zero slice, that feature may be disabled — check the matching toggle in **Filtering & Configuration**.",
        "gridPos": { "x": 16, "y": 5, "w": 8, "h": 8 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "fieldConfig": {
          "defaults": { "unit": "short" },
          "overrides": []
        },
        "targets": [
          {
            "refId": "A",
            "expr": "adguard_blocked_filtering{job=\"adguard\"}",
            "legendFormat": "Filtering",
            "instant": true
          },
          {
            "refId": "B",
            "expr": "adguard_replaced_safebrowsing{job=\"adguard\"}",
            "legendFormat": "Safe Browsing",
            "instant": true
          },
          {
            "refId": "C",
            "expr": "adguard_replaced_safesearch{job=\"adguard\"}",
            "legendFormat": "Safe Search",
            "instant": true
          },
          {
            "refId": "D",
            "expr": "adguard_replaced_parental{job=\"adguard\"}",
            "legendFormat": "Parental",
            "instant": true
          }
        ],
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "pieType": "donut",
          "legend": { "displayMode": "list", "placement": "right" }
        }
      },
      {
        "id": 300,
        "type": "row",
        "title": "Top Domains & Clients",
        "gridPos": { "x": 0, "y": 13, "w": 24, "h": 1 },
        "collapsed": false
      },
      {
        "id": 9,
        "type": "table",
        "title": "Top Queried Domains",
        "description": "The 10 most-requested domains (24h). Useful for understanding what the network talks to most. Watch for unexpected entries — a no-name domain dominating the list can indicate telemetry, malware C2, or a chatty IoT device; if so, find the talker in **Top Clients** and consider adding a block rule. [Filtering syntax for custom rules](https://adguard-dns.io/kb/general/dns-filtering-syntax/)",
        "gridPos": { "x": 0, "y": 14, "w": 8, "h": 8 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "targets": [
          {
            "refId": "A",
            "expr": "topk(10, adguard_top_queried_domains{job=\"adguard\"})",
            "instant": true,
            "format": "table"
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": { "Time": true, "__name__": true, "instance": true, "job": true },
              "renameByName": { "domain": "Domain", "Value": "Queries" },
              "indexByName": { "domain": 0, "Value": 1 }
            }
          },
          {
            "id": "sortBy",
            "options": { "fields": {}, "sort": [{ "field": "Queries", "desc": true }] }
          }
        ],
        "fieldConfig": {
          "defaults": {},
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "Queries" },
              "properties": [{ "id": "unit", "value": "short" }]
            }
          ]
        }
      },
      {
        "id": 10,
        "type": "table",
        "title": "Top Blocked Domains",
        "description": "The 10 most-blocked domains (24h). Mostly ad/tracker noise — no action needed. Scan it when a site or app misbehaves: if a domain you need is being blocked (false positive), add an exception in AdGuard (Filters → Custom rules: `@@||domain^`). Conversely, a high-volume malware/tracker domain here confirms the blocklists are doing their job. [Custom rule syntax](https://adguard-dns.io/kb/general/dns-filtering-syntax/)",
        "gridPos": { "x": 8, "y": 14, "w": 8, "h": 8 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "targets": [
          {
            "refId": "A",
            "expr": "topk(10, adguard_top_blocked_domains{job=\"adguard\"})",
            "instant": true,
            "format": "table"
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": { "Time": true, "__name__": true, "instance": true, "job": true },
              "renameByName": { "domain": "Domain", "Value": "Blocked" },
              "indexByName": { "domain": 0, "Value": 1 }
            }
          },
          {
            "id": "sortBy",
            "options": { "fields": {}, "sort": [{ "field": "Blocked", "desc": true }] }
          }
        ],
        "fieldConfig": {
          "defaults": {},
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "Blocked" },
              "properties": [{ "id": "unit", "value": "short" }]
            }
          ]
        }
      },
      {
        "id": 11,
        "type": "table",
        "title": "Top Clients",
        "description": "The busiest DNS clients (24h); Name shows the persistent client label if configured. This is your first stop when overall query volume looks abnormal — the device topping the list is the one to investigate. An unfamiliar IP generating heavy traffic warrants a look at that host. To label IPs, add a persistent client in AdGuard (Settings → Client settings).",
        "gridPos": { "x": 16, "y": 14, "w": 8, "h": 8 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "targets": [
          {
            "refId": "A",
            "expr": "topk(10, adguard_top_clients{job=\"adguard\"})",
            "instant": true,
            "format": "table"
          }
        ],
        "transformations": [
          {
            "id": "organize",
            "options": {
              "excludeByName": { "Time": true, "__name__": true, "instance": true, "job": true },
              "renameByName": { "client": "IP", "name": "Name", "Value": "Queries" },
              "indexByName": { "name": 0, "client": 1, "Value": 2 }
            }
          },
          {
            "id": "sortBy",
            "options": { "fields": {}, "sort": [{ "field": "Queries", "desc": true }] }
          }
        ],
        "fieldConfig": {
          "defaults": {},
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "Queries" },
              "properties": [{ "id": "unit", "value": "short" }]
            }
          ]
        }
      },
      {
        "id": 24,
        "type": "timeseries",
        "title": "Client Queries",
        "description": "Per-client query volume over time (filter with the **$client** variable). Use it to confirm or rule out a suspected noisy device and to see when its activity started. A client whose line ramps and stays high may be stuck in a retry/beacon loop — inspect that host or rate-limit it (see the **Ratelimit** panel).",
        "gridPos": { "x": 0, "y": 22, "w": 24, "h": 8 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "targets": [
          {
            "refId": "A",
            "expr": "adguard_top_clients{job=\"adguard\", name=~\"$client\"}",
            "legendFormat": "{{name}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": { "mode": "palette-classic" },
            "custom": {
              "drawStyle": "line",
              "lineWidth": 1,
              "fillOpacity": 10,
              "pointSize": 5,
              "showPoints": "never",
              "spanNulls": true
            }
          },
          "overrides": []
        },
        "options": {
          "tooltip": { "mode": "multi", "sort": "desc" },
          "legend": { "displayMode": "list", "placement": "bottom" }
        }
      },
      {
        "id": 400,
        "type": "row",
        "title": "Upstreams",
        "gridPos": { "x": 0, "y": 30, "w": 24, "h": 1 },
        "collapsed": false
      },
      {
        "id": 12,
        "type": "bargauge",
        "title": "Upstream Responses",
        "description": "How many answers came from each configured upstream resolver (24h). Shows load distribution across your upstreams. If one upstream shows zero while others are busy, it may be unreachable — test it and check the AdGuard upstream config (Settings → DNS settings → Upstream DNS servers). Heavy skew to a slow upstream hurts latency; see **Upstream Avg Response Time**.",
        "gridPos": { "x": 0, "y": 31, "w": 12, "h": 6 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "targets": [
          {
            "refId": "A",
            "expr": "adguard_top_upstreams_responses{job=\"adguard\"}",
            "legendFormat": "{{upstream}}",
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "color": { "mode": "palette-classic" },
            "thresholds": {
              "mode": "absolute",
              "steps": [{ "value": null, "color": "green" }]
            }
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "orientation": "horizontal",
          "displayMode": "gradient"
        }
      },
      {
        "id": 13,
        "type": "bargauge",
        "title": "Upstream Avg Response Time",
        "description": "Current mean latency to each upstream resolver. Sub-50ms is good for a nearby/encrypted resolver. An upstream consistently in the hundreds of ms is dragging down browsing — deprioritise or remove it in AdGuard's upstream config, or switch to a faster/closer resolver. Compare with **Upstream Responses** to see if the slow one is also the busiest.",
        "gridPos": { "x": 12, "y": 31, "w": 12, "h": 6 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "targets": [
          {
            "refId": "A",
            "expr": "adguard_top_upstreams_avg_time_seconds{job=\"adguard\"}",
            "legendFormat": "{{upstream}}",
            "instant": true
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "color": { "mode": "palette-classic" },
            "thresholds": {
              "mode": "absolute",
              "steps": [{ "value": null, "color": "green" }]
            }
          },
          "overrides": []
        },
        "options": {
          "reduceOptions": { "calcs": ["lastNotNull"] },
          "orientation": "horizontal",
          "displayMode": "gradient"
        }
      },
      {
        "id": 25,
        "type": "timeseries",
        "title": "Upstream Response Time",
        "description": "Upstream latency trend over time, per resolver. Flat and low is healthy. A rising or spiky line means an upstream is degrading or your internet link is congested — check the WAN, then consider reordering/removing that upstream in AdGuard (Settings → DNS settings). Brief spikes are usually transient and need no action.",
        "gridPos": { "x": 0, "y": 37, "w": 24, "h": 8 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "targets": [
          {
            "refId": "A",
            "expr": "adguard_top_upstreams_avg_time_seconds{job=\"adguard\"}",
            "legendFormat": "{{upstream}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "s",
            "color": { "mode": "palette-classic" },
            "custom": {
              "drawStyle": "line",
              "lineWidth": 1,
              "fillOpacity": 10,
              "pointSize": 5,
              "showPoints": "never",
              "spanNulls": true
            }
          },
          "overrides": []
        },
        "options": {
          "tooltip": { "mode": "multi", "sort": "desc" },
          "legend": { "displayMode": "list", "placement": "bottom" }
        }
      },
      {
        "id": 500,
        "type": "row",
        "title": "Filtering & Configuration",
        "gridPos": { "x": 0, "y": 45, "w": 24, "h": 1 },
        "collapsed": true,
        "panels": [
      {
        "id": 14,
        "type": "table",
        "title": "Filter Lists",
        "description": "Each configured blocklist with its rule count and last-update time. If a list shows **Enabled = No** unexpectedly, or **Last Updated** is days/weeks stale, filtering coverage is degraded — re-enable it or trigger an update in AdGuard (Filters → DNS blocklists → Check for updates). A list dropping to 0 rules usually means a broken/empty source URL; replace it.",
        "gridPos": { "x": 0, "y": 46, "w": 12, "h": 12 },
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "targets": [
          {
            "refId": "A",
            "expr": "adguard_filtering_list_rules{job=\"adguard\"}",
            "instant": true,
            "format": "table"
          },
          {
            "refId": "B",
            "expr": "adguard_filtering_list_last_updated_timestamp_seconds{job=\"adguard\"} * 1000",
            "instant": true,
            "format": "table"
          }
        ],
        "transformations": [
          {
            "id": "filterFieldsByName",
            "options": {
              "include": { "pattern": "^(name|enabled|Value.*)$" }
            }
          },
          {
            "id": "merge",
            "options": {}
          },
          {
            "id": "organize",
            "options": {
              "renameByName": {
                "name": "List",
                "enabled": "Enabled",
                "Value #A": "Rules",
                "Value #B": "Last Updated"
              },
              "indexByName": { "name": 0, "enabled": 1, "Value #A": 2, "Value #B": 3 }
            }
          },
          {
            "id": "sortBy",
            "options": { "fields": {}, "sort": [{ "field": "Rules", "desc": true }] }
          }
        ],
        "fieldConfig": {
          "defaults": {},
          "overrides": [
            {
              "matcher": { "id": "byName", "options": "Rules" },
              "properties": [{ "id": "unit", "value": "short" }]
            },
            {
              "matcher": { "id": "byName", "options": "Enabled" },
              "properties": [
                {
                  "id": "mappings",
                  "value": [
                    {
                      "type": "value",
                      "options": {
                        "true": { "text": "Yes", "color": "green" },
                        "false": { "text": "No", "color": "red" }
                      }
                    }
                  ]
                }
              ]
            },
            {
              "matcher": { "id": "byName", "options": "Last Updated" },
              "properties": [
                { "id": "unit", "value": "dateTimeAsIso" },
                { "id": "decimals", "value": 0 }
              ]
            }
          ]
        }
      },
      {
        "id": 15,
        "type": "stat",
        "title": "Filter Rules",
        "description": "Total active rules across all enabled blocklists. A healthy setup is typically tens of thousands to low millions. A sudden drop means a list failed to load or was disabled — check **Filter Lists** above and re-update. Informational otherwise.",
